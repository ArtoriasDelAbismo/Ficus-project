PORT=3000

# Origin allowed to call this API. Use "*" only for local dev.
CORS_ORIGIN=*

# Shared secret required in the 'x-admin-key' header to create/edit/deactivate
# módulos. Without this set, write endpoints are open to anyone — set a real
# value before deploying.
ADMIN_API_KEY=change-me

# Optional: override where the SQLite file lives. Defaults to backend/data/ficus.db
# DATABASE_PATH=/absolute/path/to/ficus.db
